#!/usr/bin/env python3
"""判斷這台機器跑不跑得動本地 ASR，輸出機器可讀的裁決。

設計原則：**不猜門檻。** 三層都不是猜——
  地板：mlx 裝不裝得起來、Metal 工作集上限多少（查得到，不是估的）
  探針：灰色地帶才真的載一次模型量（未實作，見 TODO）
  快取：一台量一次，寫 ~/.config/srt/capacity.conf

為什麼要分模型判斷：同一台機器對兩個模型的答案可能不同。
8GB 的 Mac 上 Breeze（2.9 GB）跑得動、VibeVoice（4-bit 5.32 GiB）貼著上限——
而 Metal 超過工作集是**直接報 buffer 錯**不是變慢，所以那是結構性的不可能。

輸出（一行一個 key=value）：
  mlx=yes|no
  ram_gb=<float>
  metal_working_set_gib=<float|unknown>
  breeze_local=ok|risky|impossible
  vv_local=ok|risky|impossible
  reason=<一句話>
"""
import json, os, pathlib, shutil, subprocess, sys

# 模型在 Hugging Face 上的名字。權重大小【不寫死】——去讀實際檔案。
BREEZE_REPO = "eoleedi/Breeze-ASR-25-mlx"
VV_REPO = "mlx-community/VibeVoice-ASR-4bit"

# 只有在完全讀不到實際檔案時才用的退路值，單位 GiB。
# ⚠️ 這些是退路不是真相。原本寫死 BREEZE_GB=2.9 是 `du -sh` 的十進位顯示，
# 而實際 weights.safetensors 是 3,082,909,389 bytes = 2.87 GiB——
# 兩個數字差 1%，但工作集上限只有 5.33 GiB 時這種誤差會改變判斷。
# （Fable review-20 指出：不要用常數，去讀檔案大小。）
BREEZE_FALLBACK_GIB = 2.87
VV_FALLBACK_GIB = 5.32

# 推論期的額外用量。雲端實測 VV 生成階段 4.68 GiB。
# Breeze 沒有實測，保守給 1.0——想要真數字請用 --probe（見下）。
VV_INFER_GIB = 4.68
BREEZE_INFER_GIB = 1.0


def weights_gib(repo: str, fallback: float) -> tuple:
    """回 (大小 GiB, 來源說明)。

    優先讀本機 HF 快取裡的實際檔案大小；沒下載過就問 HF API 要 bytes；
    兩者都不行才用退路常數。回傳來源說明，讓報告看得出這個數字是量的還是猜的。
    """
    cache = pathlib.Path.home() / ".cache/huggingface/hub" / ("models--" + repo.replace("/", "--"))
    if cache.is_dir():
        total = 0
        for f in cache.rglob("*"):
            try:
                if f.is_file() and not f.is_symlink():
                    total += f.stat().st_size
            except OSError:
                pass
        if total > 0:
            return total / 1024**3, "本機快取實測"
    try:
        import urllib.request
        req = urllib.request.Request(
            f"https://huggingface.co/api/models/{repo}?blobs=true",
            headers={"User-Agent": "srt-capacity-check/1.0"},
        )
        data = json.loads(urllib.request.urlopen(req, timeout=15).read())
        total = sum(sib.get("size") or 0 for sib in data.get("siblings", []))
        if total > 0:
            return total / 1024**3, "Hugging Face API"
    except Exception:
        pass
    return fallback, "退路常數（沒量到，可能不準）"

CACHE = pathlib.Path.home() / ".config/srt/capacity.conf"


def ram_gb() -> float:
    try:
        out = subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True, timeout=10)
        return int(out.stdout.strip()) / 1024**3
    except Exception:
        try:  # Linux
            for line in pathlib.Path("/proc/meminfo").read_text().splitlines():
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) / 1024**2
        except Exception:
            pass
    return 0.0


def has_mlx() -> bool:
    """裝在虛擬環境裡的套件不會出現在 PATH 上，所以不能用 which 判斷。
    （2026-08-30 實測：Mini CC 的 venv-mlx 明明裝好了，which 仍然找不到，
    探針因此誤判「沒裝」。這是「which 找不到不等於沒裝」的經典陷阱。）
    直接用目前這個直譯器試 import，才是真的答案。"""
    r = subprocess.run(
        [sys.executable, "-c", "import mlx_whisper"],
        capture_output=True, text=True, timeout=60,
    )
    if r.returncode == 0:
        return True
    # 退一步：模組沒有，但 CLI 在 PATH 上也算裝了
    return shutil.which("mlx_whisper") is not None


def metal_working_set_gib():
    """Metal 的工作集上限，單位 GiB（1024^3），不是 GB（10^9）。

    ⚠️ 單位一定要跟模型大小對齊。同一台 8 GB 的 M1 量出來是
    5.73 GB＝5.33 GiB，兩個數字都對但差 7%，混用會得到錯誤的餘裕。
    模型權重習慣用 GiB 標示（VibeVoice 是 5.32 GiB），所以這裡統一用 GiB。

    超過這個上限，MLX 是直接報 buffer 錯，不是變慢。"""
    try:
        out = subprocess.run(
            [sys.executable, "-c",
             "import mlx.core as mx; print(mx.metal.device_info()['max_recommended_working_set_size'])"],
            capture_output=True, text=True, timeout=30)
        if out.returncode == 0 and out.stdout.strip().isdigit():
            return int(out.stdout.strip()) / 1024**3
    except Exception:
        pass
    return None


def verdict(need_gb: float, budget_gb: float):
    """budget 是可用預算（工作集上限，取不到就用 RAM 扣掉 OS）。"""
    if budget_gb <= 0:
        return "impossible", "取不到可用記憶體上限"
    if need_gb > budget_gb:
        return "impossible", f"需要 {need_gb:.2f} GiB 超過上限 {budget_gb:.2f} GiB"
    margin = budget_gb - need_gb
    if margin < 1.0:
        return "risky", f"需要 {need_gb:.2f} GiB、上限 {budget_gb:.2f} GiB，餘裕僅 {margin:.2f} GiB"
    return "ok", f"需要 {need_gb:.2f} GiB、上限 {budget_gb:.2f} GiB，餘裕 {margin:.2f} GiB"


# 各機型實測的辨識速度（倍率＝影片長度 ÷ 辨識耗時，越大越快）。
# 「跑得動」不等於「值得跑」——8 GB 的機器跑得動 Breeze，但比雲端慢 2.3 倍。
# 這些是 2026-08-30 用同一段 60 秒音檔實測的：
#   M1 Max 32GB   17 倍
#   M1 基本款 8GB   3.5 倍（60 秒音檔跑 17 秒，模型已在本機）
#   雲端 RTX 4090  40 倍（一支 109 分鐘影片 13.4 分鐘，含開機，約 US$0.17）
SPEED_RATIO_BY_TIER = {"low": 3.5, "mid": 8.0, "high": 17.0}
CLOUD_MINUTES_PER_HOUR_OF_VIDEO = 7.4   # 109 分鐘影片 13.4 分鐘換算
CLOUD_USD_PER_HOUR_OF_VIDEO = 0.094     # 0.17 美元 ÷ 1.82 小時


def speed_hint(ram_gb: float) -> str:
    """回一句白話，講「本地跑得動，但要多久」。"""
    if ram_gb <= 8.5:
        tier = "low"
    elif ram_gb < 24:
        tier = "mid"
    else:
        tier = "high"
    ratio = SPEED_RATIO_BY_TIER[tier]
    if tier == "high":
        return f"本地約 {ratio:.0f} 倍速，比雲端划算"
    local_min = 60 / ratio
    return (f"本地約 {ratio:.1f} 倍速（一小時的影片要跑 {local_min:.0f} 分鐘），"
            f"雲端約 {CLOUD_MINUTES_PER_HOUR_OF_VIDEO:.0f} 分鐘、"
            f"US${CLOUD_USD_PER_HOUR_OF_VIDEO:.2f}")


def main():
    if "--no-cache" not in sys.argv and CACHE.is_file():
        cached = CACHE.read_text(encoding="utf-8")
        if f"host={os.uname().nodename}" in cached:
            print(cached.rstrip())
            return

    mlx = has_mlx()
    ram = ram_gb()
    ws = metal_working_set_gib()
    # 取不到工作集上限時，用 RAM 扣掉 macOS 常駐（保守 2.5 GB）當預算
    budget = ws if ws else max(0.0, ram - 2.5)

    breeze_w, breeze_src = weights_gib(BREEZE_REPO, BREEZE_FALLBACK_GIB)
    vv_w, vv_src = weights_gib(VV_REPO, VV_FALLBACK_GIB)

    if not mlx:
        b_v, b_r = "impossible", "mlx_whisper 未安裝"
        v_v, v_r = "impossible", "mlx_whisper 未安裝"
    else:
        b_v, b_r = verdict(breeze_w + BREEZE_INFER_GIB, budget)
        # 顯式地板：8 GB 機器的 Metal 工作集上限約 5.3-5.5 GB，
        # VV 光權重就 5.32 GiB 貼著線。超過工作集是**直接報 buffer 錯**不是變慢，
        # 所以這是結構性的不可能，不是「餘裕不足」。
        # 不依賴上面的算式——取不到工作集上限時算式會走 RAM 推估，那條路較不可靠。
        if ram <= 8.5:
            v_v, v_r = "impossible", (
                f"RAM {ram:.1f} GB：實測 8GB M1 的 Metal 工作集上限 5.33 GiB，"
                f"VV 權重 {vv_w:.2f} GiB（{vv_src}）貼線，超過是硬錯不是變慢"
            )
        else:
            v_v, v_r = verdict(vv_w + VV_INFER_GIB, budget)
            # 8 < RAM < 16 的灰色地帶：算式說 ok 也要降成 risky，等探針給實數
            if v_v == "ok" and ram < 16:
                v_v, v_r = "risky", f"RAM {ram:.1f} GB 落在灰色地帶（8-16 GB），需實機探針確認：{v_r}"

    lines = [
        f"host={os.uname().nodename}",
        f"mlx={'yes' if mlx else 'no'}",
        f"ram_gb={ram:.1f}",
        f"metal_working_set_gib={ws:.2f}" if ws else "metal_working_set_gib=unknown",
        f"speed_hint={speed_hint(ram)}",
        f"breeze_weights_gib={breeze_w:.2f} ({breeze_src})",
        f"vv_weights_gib={vv_w:.2f} ({vv_src})",
        f"breeze_local={b_v}",
        # 逐模型的原因分開輸出。合在一起的 reason= 保留給人看，
        # 但下游（subtitle.sh）需要單獨取 Breeze 那一半——
        # 之前只有合併版，subtitle.sh 抓 breeze_reason= 抓不到，
        # 於是印出預設字串「記憶體不足」，而真因是「mlx_whisper 未安裝」。
        # 那會讓使用者去買記憶體而不是去裝套件。
        f"breeze_reason={b_r}",
        f"vv_reason={v_r}",
        f"vv_local={v_v}",
        f"reason=Breeze: {b_r}｜VibeVoice: {v_r}",
    ]
    out = "\n".join(lines)
    print(out)
    try:
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(out + "\n", encoding="utf-8")
    except Exception:
        pass  # 寫不了快取不影響判斷


if __name__ == "__main__":
    main()
